# Rust build artefacts
src-tauri/target/
target/
**/*.rs.bk

# Tauri build output
src-tauri/gen/
dist/

# Frontend deps
node_modules/
package-lock.json

# Synced asset — refreshed locally at build time from /ui-system/
# (the script scripts/sync-koher-ui.sh overwrites this file). From
# v0.1.7 onward the vendored copy IS tracked in git so CI (which has
# no access to the parent /ui-system/ folder) can build without
# invoking the sync script. When the source CSS in /ui-system/
# changes, run the sync script locally and commit the diff — that
# is the canonical update path. Prior branches kept this file
# gitignored; the v0.1.7 branch un-ignores it and commits the file.

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Logs
*.log

# Environment files (never commit secrets)
.env
.env.local

# Tauri-specific
WixTools/

# Bundle artefacts
bundle/

# Flatpak-builder working directories
.flatpak-builder/
build-dir/

# Rendered flatpak manifest (generated by scripts/build-flatpak.sh from
# the template; version comes from package.json — never committed).
packaging/flatpak/app.koher.sensorium.rendered.yml

# Compiled binaries — distributed via GitHub Releases, not in the repo.
# Exception: `releases/<platform-arch>/` is the cross-host staging area —
# build outputs travel between Mac / Linux dev hosts via the repo before
# being attached to a GitHub Release. See `releases/README.md`.
*.dmg
*.deb
*.flatpak
*.app
*.tar.gz
!releases/**/*.dmg
!releases/**/*.deb
!releases/**/*.flatpak

# Internal-only working notes (kept on the dev machine, not published)
BUILD-STATUS.md
CLAUDE.md

